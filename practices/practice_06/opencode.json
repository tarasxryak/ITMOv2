{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "threat-judge": {
      "description": "Independent reviewer of the submitted threat model",
      "mode": "primary",
      "prompt": "{file:./judge-system-prompt.md}",
      "steps": 1,
      "permission": {
        "*": "deny",
        "read": {
          "*": "deny"
        }
      }
    },
    "shop-planner": {
      "description": "Model under test: produces a shop action without executing tools",
      "mode": "primary",
      "prompt": "{file:./planner-system.txt}",
      "permission": {
        "*": "deny"
      },
      "steps": 1
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B local",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  }
}
